# Copy to .env.local and fill in. Never commit .env.local.

# Intent understanding: tried in this order, falls back to a keyword
# parser if neither is configured or both fail.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GEMINI_API_KEY_1..GEMINI_API_KEY_6 / GOOGLE_API_KEY also work if you
# have multiple keys to round-robin across (see lib/pipeline/understand.ts).

# Supabase (verified directory). NEXT_PUBLIC_SUPABASE_URL is required —
# the publishable/secret keys alone aren't enough to construct a client.
# Accepts either the legacy anon/service_role JWTs or the newer
# sb_publishable_/sb_secret_ key format — both work as drop-in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sarvam AI (Indic ASR / translation). SARVAM_API_KEY_1..5 also work
# for round-robin across multiple keys on rate limits.
SARVAM_API_KEY=

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin console shared password (MVP-only auth, not real auth)
ADMIN_PASSWORD=
